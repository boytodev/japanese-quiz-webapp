<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>ごいゲームチャレンジ - เกมคำศัพท์ N4-N5</title>

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;600;700&family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  padding: 0;
  height: 100vh;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: 'Kanit', 'Noto Serif JP', serif;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  position: relative;
}

body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('/images/bg2.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0.3;
  z-index: 0;
}

/* พระอาทิตย์สไตล์ญี่ปุ่น */
.sun {
  position: absolute;
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(255, 179, 71, 0.4), rgba(204, 119, 34, 0.2));
  border-radius: 50%;
  top: 15%;
  right: 10%;
  z-index: 1;
  animation: sunGlow 4s ease-in-out infinite alternate;
}

@keyframes sunGlow {
  0% { transform: scale(1); opacity: 0.3; }
  100% { transform: scale(1.1); opacity: 0.5; }
}

/* กล่องกลาง */
.container {
  text-align: center;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  padding: 80px 60px;
  border-radius: 30px;
  box-shadow: 
    0 25px 50px rgba(0, 0, 0, 0.2),
    0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  z-index: 2;
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
  overflow: hidden;
  max-width: 600px;
  margin: 0 20px;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

h1 {
  background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcf7f, #4d96ff);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 3.5em;
  margin-bottom: 20px;
  font-weight: 700;
  animation: gradientShift 3s ease-in-out infinite;
  letter-spacing: 2px;
}

@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.subtitle {
  font-size: 1.4em;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 50px;
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
  font-weight: 300;
  line-height: 1.6;
}

/* ปุ่มสไตล์ญี่ปุ่น */
.start-btn {
  padding: 20px 60px;
  font-size: 1.4em;
  font-weight: 600;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  color: white;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  position: relative;
  overflow: hidden;
}

.start-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.start-btn:hover::before {
  left: 100%;
}

.start-btn:hover {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
  border-color: rgba(255, 255, 255, 0.6);
  transform: translateY(-5px) scale(1.05);
  box-shadow: 0 25px 50px rgba(255, 255, 255, 0.2);
}

.start-btn:active {
  transform: translateY(-2px) scale(1.02);
}

/* ซากุระ */
.sakura {
  position: absolute;
  width: 12px;
  height: 12px;
  background: linear-gradient(45deg, #ffb3d9, #ff99cc);
  border-radius: 50% 50% 50% 0;
  transform: rotate(45deg);
  opacity: 0.7;
  animation: fall linear infinite;
  z-index: 1;
}

.sakura::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(45deg, #ffccdd, #ffb3d9);
  border-radius: 50% 50% 50% 0;
  transform: rotate(90deg);
}

@keyframes fall {
  from {
    transform: translateY(-10vh) rotate(0deg);
    opacity: 0.7;
  }
  to {
    transform: translateY(110vh) rotate(360deg);
    opacity: 0;
  }
}

/* Responsive */
@media (max-width: 768px) {
  .container {
    padding: 50px 30px;
    margin: 0 15px;
  }

  h1 {
    font-size: 2.5em;
    margin-bottom: 15px;
  }

  .subtitle {
    font-size: 1.2em;
    margin-bottom: 35px;
  }

  .start-btn {
    padding: 18px 45px;
    font-size: 1.2em;
  }

  .sun {
    width: 200px;
    height: 200px;
    top: 10%;
    right: 5%;
  }
}

@media (max-width: 480px) {
  .container {
    padding: 40px 25px;
    margin: 0 10px;
  }

  h1 {
    font-size: 2em;
    margin-bottom: 12px;
  }

  .subtitle {
    font-size: 1.1em;
    margin-bottom: 30px;
  }

  .start-btn {
    padding: 15px 35px;
    font-size: 1.1em;
  }

  .sun {
    width: 150px;
    height: 150px;
  }
}
</style>
</head>

<body>

<div class="sun"></div>

<div class="container">
  <h1>ごいゲームチャレンジ<br>เกมคำศัพท์ N4 - N5</h1>
  <p class="subtitle">ทดสอบความรู้ภาษาญี่ปุ่นของคุณ<br>พร้อมระบบคะแนนและพื้นหลังที่เปลี่ยนแปลง</p>
  
  <button class="start-btn" onclick="startGame()">🚀 เริ่มเกม</button>
</div>

<script>
function startGame() {
  // เพิ่ม animation ก่อนเปลี่ยนหน้า
  const btn = document.querySelector('.start-btn');
  btn.style.transform = 'scale(0.95)';
  btn.style.opacity = '0.8';
  
  setTimeout(() => {
    window.location.href = "/game";
  }, 200);
}

/* สร้างซากุระ */
function createSakura() {
  for (let i = 0; i < 30; i++) {
    const sakura = document.createElement("div");
    sakura.className = "sakura";
    sakura.style.left = Math.random() * 100 + "vw";
    sakura.style.animationDuration = (8 + Math.random() * 10) + "s";
    sakura.style.animationDelay = Math.random() * 5 + "s";
    sakura.style.opacity = Math.random() * 0.7 + 0.3;
    document.body.appendChild(sakura);
  }
}

// เริ่มสร้างซากุระ
createSakura();

// สร้างซากุระใหม่ทุก 3 วินาที
setInterval(() => {
  if (document.querySelectorAll('.sakura').length < 50) {
    createSakura();
  }
}, 3000);
</script>

</body>
</html>