<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>เกมควิซภาษาญี่ปุ่น</title>

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@600&display=swap" rel="stylesheet">

<style>
body {
  margin: 0;
  padding: 0;
  height: 100vh;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: 'Noto Serif JP', serif;
  background-image: url('/images/bg2.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  color: white;
}

/* พระอาทิตย์สไตล์ญี่ปุ่น */
.sun {
  position: absolute;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, #ffb347, #cc7722);
  border-radius: 50%;
  top: 10%;
  z-index: 0;
  opacity: 0.3;
}

/* กล่องกลาง */
.container {
  text-align: center;
  background: rgba(0, 0, 0, 0.65);
  padding: 60px;
  border-radius: 20px;
  box-shadow: 0 0 40px rgba(255,255,255,0.2);
  z-index: 2;
}

h1 {
  font-size: 48px;
  margin-bottom: 40px;
}

/* ปุ่มสไตล์ญี่ปุ่น */
.start-btn {
  padding: 18px 60px;
  font-size: 22px;
  border: 2px solid #a67c52;
  border-radius: 50px;
  background: transparent;
  color: #a67c52;
  cursor: pointer;
  transition: 0.3s;
}

.start-btn:hover {
  background: #a67c52;
  color: white;
  transform: scale(1.1);
  box-shadow: 0 0 20px #a67c52;
}

/* ซากุระ */
.sakura {
  position: absolute;
  width: 15px;
  height: 15px;
  background: pink;
  border-radius: 50% 50% 50% 0;
  transform: rotate(45deg);
  opacity: 0.8;
  animation: fall linear infinite;
}

@keyframes fall {
  from {
    transform: translateY(-10vh) rotate(0deg);
  }
  to {
    transform: translateY(110vh) rotate(360deg);
  }
}
</style>
</head>

<body>

<div class="sun"></div>

<div class="container">
  <h1>เกมควิซภาษาญี่ปุ่น 🎌</h1>
  <button class="start-btn" onclick="startGame()">เริ่มเกม</button>
</div>

<script>
function startGame() {
  window.location.href = "/survey";
}

/* สร้างซากุระ */
for (let i = 0; i < 40; i++) {
  const sakura = document.createElement("div");
  sakura.className = "sakura";
  sakura.style.left = Math.random() * 100 + "vw";
  sakura.style.animationDuration = (5 + Math.random() * 5) + "s";
  sakura.style.opacity = Math.random();
  document.body.appendChild(sakura);
}
</script>

</body>
</html>