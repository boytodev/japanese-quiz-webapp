<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>แบบสอบถาม - เกมควิซภาษาญี่ปุ่น</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-image: url('/images/bg2.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        min-height: 100vh;
        padding: 40px 20px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .overlay {
        background-color: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
      }

      h1 {
        color: #a67c52;
        text-align: center;
        margin-bottom: 30px;
        font-size: 2em;
      }

      .form-group {
        margin-bottom: 25px;
      }

      label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-weight: 600;
      }

      input[type="text"],
      input[type="tel"] {
        width: 100%;
        padding: 12px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1em;
        transition: border-color 0.3s;
      }

      input[type="text"]:focus,
      input[type="tel"]:focus {
        outline: none;
        border-color: #856d4d;
      }

      .radio-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .radio-option {
        display: flex;
        align-items: center;
        padding: 10px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s;
      }

      .radio-option:hover {
        background: #f5f5f5;
        border-color: #856d4d;
      }

      .radio-option input[type="radio"] {
        margin-right: 10px;
        cursor: pointer;
      }

      #schoolField {
        display: none;
        margin-top: 15px;
      }

      .privacy-notice {
        background: #f0f0f0;
        padding: 15px;
        border-radius: 8px;
        font-size: 0.9em;
        color: #666;
        margin-bottom: 20px;
      }

      .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, #a67c52 0%, #856d4d 100%);
        color: white;
        border: none;
        padding: 15px;
        font-size: 1.2em;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s;
      }

      .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(166, 124, 82, 0.4);
      }

      .required {
        color: red;
      }

      /* Responsive Design */
      @media (max-width: 768px) {
        body {
          padding: 30px 15px;
        }

        .container {
          padding: 30px 20px;
        }

        h1 {
          font-size: 1.6em;
          margin-bottom: 25px;
        }

        .form-group {
          margin-bottom: 20px;
        }

        input[type="text"],
        input[type="tel"] {
          padding: 10px;
          font-size: 0.95em;
        }

        .radio-option {
          padding: 8px;
          font-size: 0.95em;
        }

        .privacy-notice {
          padding: 12px;
          font-size: 0.85em;
        }

        .submit-btn {
          padding: 12px;
          font-size: 1.1em;
        }
      }

      @media (max-width: 480px) {
        body {
          padding: 20px 10px;
        }

        .container {
          padding: 25px 15px;
        }

        h1 {
          font-size: 1.4em;
          margin-bottom: 20px;
        }

        .form-group {
          margin-bottom: 18px;
        }

        label {
          font-size: 0.95em;
          margin-bottom: 6px;
        }

        input[type="text"],
        input[type="tel"] {
          padding: 10px;
          font-size: 0.9em;
        }

        .radio-option {
          padding: 8px;
          font-size: 0.9em;
        }

        .privacy-notice {
          padding: 10px;
          font-size: 0.8em;
          margin-bottom: 15px;
        }

        .submit-btn {
          padding: 12px;
          font-size: 1em;
        }
      }
    </style>
  </head>
  <body>
    <div class="container overlay">
      <h1>📋 แบบสอบถาม</h1>

      <form action="/survey" method="POST" onsubmit="return validateForm();">
        <div class="form-group">
          <label>ชื่อ-นามสกุล <span class="required">*</span></label>
          <input
            type="text"
            name="fullname"
            id="fullname"
            required
            placeholder="กรุณากรอกชื่อ-นามสกุล"
          />
        </div>

        <div class="form-group">
          <label>กลุ่มผู้ใช้ <span class="required">*</span></label>
          <div class="radio-group">
            <label class="radio-option">
              <input
                type="radio"
                name="group"
                value="student"
                required
                onchange="toggleSchoolField()"
              />
              นักเรียน/นักศึกษา
            </label>
            <label class="radio-option">
              <input
                type="radio"
                name="group"
                value="worker"
                required
                onchange="toggleSchoolField()"
              />
              บุคคลทั่วไป/ผู้ทำงานแล้ว
            </label>
          </div>

          <div id="schoolField">
            <label>ชื่อโรงเรียน/สถาบัน</label>
            <input
              type="text"
              name="school"
              id="school"
              placeholder="กรุณากรอกชื่อโรงเรียน/สถาบัน"
            />
          </div>
        </div>

        <div class="form-group">
          <label
            >ปัจจุบันใช้ภาษาญี่ปุ่นในการทำงานหรือไม่
            <span class="required">*</span></label
          >
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="useJapanese" value="yes" required />
              ใช้
            </label>
            <label class="radio-option">
              <input type="radio" name="useJapanese" value="no" required />
              ไม่ใช้
            </label>
            <label class="radio-option">
              <input
                type="radio"
                name="useJapanese"
                value="sometimes"
                required
              />
              ใช้บางครั้ง
            </label>
          </div>
        </div>

        <div class="form-group">
          <label
            >หากท่านสนใจที่จะให้ทางโรงเรียนติดต่อกลับเกี่ยวกับคอร์สเรียนของทางวาเซดะ
            โปรดกรอกเบอร์ไว้</label
          >
          <input
            type="tel"
            name="phone"
            id="phone"
            placeholder="0XX-XXX-XXXX"
            pattern="[0-9]{9,10}"
          />
        </div>

        <div class="form-group">
          <label>เลือกระดับความยาก <span class="required">*</span></label>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="level" value="N5" required />
              N5 - ระดับเริ่มต้น (ง่าย)
            </label>
            <label class="radio-option">
              <input type="radio" name="level" value="N4" required />
              N4 - ระดับกลาง (ปานกลาง)
            </label>
            <label class="radio-option">
              <input type="radio" name="level" value="ALL" required />
              ทั้งหมด - ผสมทุกระดับ
            </label>
          </div>
        </div>

        <div class="privacy-notice">
          🔒
          ข้อมูลของคุณจะถูกเก็บเป็นความลับและใช้เพื่อวัตถุประสงค์ในการพัฒนาระบบเท่านั้น
        </div>

        <button type="submit" class="submit-btn">ส่งข้อมูลและเริ่มเกม →</button>
      </form>
    </div>

    <script>
      function toggleSchoolField() {
        const studentRadio = document.querySelector(
          'input[name="group"][value="student"]',
        );
        const schoolField = document.getElementById("schoolField");
        const schoolInput = document.getElementById("school");

        if (studentRadio.checked) {
          schoolField.style.display = "block";
          schoolInput.required = true;
        } else {
          schoolField.style.display = "none";
          schoolInput.required = false;
          schoolInput.value = "";
        }
      }

      function validateForm() {
        const fullname = document.getElementById("fullname").value.trim();
        const phone = document.getElementById("phone").value.trim();

        if (fullname === "") {
          alert("กรุณากรอกชื่อ-นามสกุล");
          return false;
        }

        if (phone === "" || phone.length < 9) {
          alert("กรุณากรอกเบอร์โทรศัพท์ให้ถูกต้อง");
          return false;
        }

        return true;
      }
    </script>
  </body>
</html>
