<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เกมควิซภาษาญี่ปุ่น</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #f8f1e4 0%, #e1d7c6 100%);
      min-height: 100vh;
      padding: 40px 20px;
      position: relative;
      transition: background 0.5s ease;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      opacity: 0;
      transition: opacity 1s ease;
      z-index: 0;
      pointer-events: none;
    }

    body.has-background::before {
      opacity: 1;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 20px;
      position: relative;
      z-index: 1;
    }

    h1 {
      color: #a67c52;
      text-align: center;
      margin-bottom: 30px;
      font-size: 3em;
      text-shadow: 4px 4px 15px rgba(0, 0, 0, 0.8);
      font-weight: 700;
      letter-spacing: 2px;
    }

    /* Game Section Styles */
    #gameSection h1 {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 3.2em;
      margin-bottom: 30px;
      font-weight: 800;
      text-align: center;
      letter-spacing: 1px;
    }

    .score-header {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 25px;
      padding: 25px;
      margin-bottom: 30px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    }

    .score-item {
      text-align: center;
      padding: 15px;
      border-radius: 15px;
      background: rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
    }

    .score-item:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .score-label {
      font-size: 0.95em;
      opacity: 0.9;
      margin-bottom: 8px;
      text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
      font-weight: 500;
    }

    .score-value {
      font-size: 2.2em;
      font-weight: 700;
      text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.4);
      color: #fff;
    }

    .progress-bar {
      width: 100%;
      height: 15px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      margin-bottom: 40px;
      overflow: hidden;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1) inset;
    }

    .progress {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
      background-size: 200% 100%;
      width: 0%;
      transition: width 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      border-radius: 20px;
      box-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
      animation: progressGlow 2s ease-in-out infinite alternate;
    }

    @keyframes progressGlow {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }

    .question-card {
      display: none;
      animation: slideInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 30px;
      padding: 40px;
      box-shadow: 
        0 25px 50px rgba(0, 0, 0, 0.15),
        0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      position: relative;
      overflow: hidden;
    }

    .question-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      transition: left 0.5s ease;
    }

    .question-card.active {
      display: block;
    }

    .question-card.active::before {
      left: 100%;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .question-number {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.2em;
      margin-bottom: 25px;
      font-weight: 600;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .instruction {
      background: linear-gradient(135deg, #ffeaa7, #fdcb6e);
      color: #2d3436;
      padding: 20px 25px;
      border-radius: 20px;
      margin-bottom: 25px;
      font-size: 1.1em;
      font-weight: 600;
      text-align: center;
      box-shadow: 0 10px 30px rgba(253, 203, 110, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .question-text {
      font-size: 1.8em;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 35px;
      line-height: 1.6;
      text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.6);
      font-weight: 600;
      text-align: center;
      padding: 20px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .option {
      padding: 25px 20px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      font-size: 1.2em;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      color: rgba(255, 255, 255, 0.95);
      font-weight: 600;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      position: relative;
      overflow: hidden;
    }

    .option::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s ease;
    }

    .option:hover {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
      border-color: rgba(255, 255, 255, 0.5);
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 20px 40px rgba(255, 255, 255, 0.1);
    }

    .option:hover::before {
      left: 100%;
    }

    .option.correct {
      background: linear-gradient(145deg, rgba(46, 204, 113, 0.9), rgba(39, 174, 96, 0.8));
      color: white;
      border-color: rgba(46, 204, 113, 0.8);
      animation: correctPulse 0.6s ease;
      box-shadow: 0 0 30px rgba(46, 204, 113, 0.5);
    }

    .option.wrong {
      background: linear-gradient(145deg, rgba(231, 76, 60, 0.9), rgba(192, 57, 43, 0.8));
      color: white;
      border-color: rgba(231, 76, 60, 0.8);
      animation: wrongShake 0.6s ease;
      box-shadow: 0 0 30px rgba(231, 76, 60, 0.5);
    }

    @keyframes correctPulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    @keyframes wrongShake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-8px); }
      20%, 40%, 60%, 80% { transform: translateX(8px); }
    }

    .nav-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
    }

    .btn {
      padding: 15px 35px;
      border: none;
      border-radius: 25px;
      font-size: 1.2em;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s ease;
    }

    .btn:hover::before {
      left: 100%;
    }

    .btn-back {
      background: linear-gradient(135deg, rgba(108, 117, 125, 0.9), rgba(90, 98, 104, 0.8));
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-back:hover {
      background: linear-gradient(135deg, rgba(108, 117, 125, 1), rgba(90, 98, 104, 0.9));
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 15px 40px rgba(108, 117, 125, 0.4);
    }

    .btn-next {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-next:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }

    /* Loading Animation */
    .loading {
      text-align: center;
      padding: 80px 20px;
      font-size: 1.8em;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 600;
    }

    .loading::after {
      content: '';
      display: inline-block;
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      border-top-color: #667eea;
      animation: spin 1s ease-in-out infinite;
      margin-left: 15px;
      vertical-align: middle;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Background Change Notification */
    .bg-change-notification {
      position: fixed;
      top: 30px;
      right: 30px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 20px 30px;
      border-radius: 20px;
      font-size: 1.2em;
      font-weight: 600;
      box-shadow: 0 15px 40px rgba(102, 126, 234, 0.4);
      z-index: 1000;
      animation: slideInRight 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), fadeOut 0.6s ease 2.5s forwards;
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    @keyframes slideInRight {
      from {
        transform: translateX(400px) scale(0.8);
        opacity: 0;
      }
      to {
        transform: translateX(0) scale(1);
        opacity: 1;
      }
    }

    @keyframes fadeOut {
      to {
        opacity: 0;
        transform: translateX(400px) scale(0.8);
      }
    }

    /* Level Selection Styles */
    .level-selection {
      text-align: center;
      padding: 60px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .level-selection h1 {
      background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcf7f, #4d96ff);
      background-size: 300% 300%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-size: 3.5em;
      margin-bottom: 20px;
      font-weight: 800;
      animation: gradientShift 3s ease-in-out infinite;
      text-shadow: none;
      letter-spacing: 2px;
    }

    @keyframes gradientShift {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .subtitle {
      font-size: 1.3em;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 50px;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.7);
      font-weight: 300;
    }

    .level-cards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
      max-width: 800px;
      margin: 0 auto;
      width: 100%;
    }

    .level-card {
      position: relative;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 30px;
      padding: 50px 35px;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      color: white;
      text-align: center;
      box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      overflow: hidden;
    }

    .level-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .level-card:hover::before {
      opacity: 1;
    }

    .level-card:hover {
      transform: translateY(-15px) scale(1.02);
      box-shadow: 
        0 30px 60px rgba(0, 0, 0, 0.2),
        0 0 0 1px rgba(255, 255, 255, 0.3) inset;
      border-color: rgba(255, 255, 255, 0.4);
    }

    .level-card.n5 {
      background: linear-gradient(145deg, rgba(255, 107, 107, 0.2), rgba(255, 107, 107, 0.1));
    }

    .level-card.n4 {
      background: linear-gradient(145deg, rgba(77, 150, 255, 0.2), rgba(77, 150, 255, 0.1));
    }

    .level-card.mixed {
      background: linear-gradient(145deg, rgba(107, 207, 127, 0.2), rgba(107, 207, 127, 0.1));
    }

    .level-icon {
      font-size: 4em;
      margin-bottom: 20px;
      display: block;
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    }

    .level-title {
      font-size: 2.8em;
      font-weight: 700;
      margin-bottom: 15px;
      text-shadow: 2px 2px 12px rgba(0, 0, 0, 0.5);
      letter-spacing: 1px;
    }

    .level-desc {
      font-size: 1.4em;
      margin-bottom: 20px;
      color: rgba(255, 255, 255, 0.95);
      text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.4);
      font-weight: 500;
    }

    .level-info {
      font-size: 1.1em;
      color: rgba(255, 255, 255, 0.85);
      line-height: 1.6;
      text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.3);
      font-weight: 300;
    }

    .level-stats {
      margin-top: 25px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      font-size: 0.95em;
      color: rgba(255, 255, 255, 0.7);
    }

    /* Instruction Styles */
    .instruction {
      background: rgba(255, 193, 7, 0.9);
      color: #333;
      padding: 15px 20px;
      border-radius: 15px;
      margin-bottom: 20px;
      font-size: 1.1em;
      font-weight: 600;
      text-align: center;
      box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
      border: 2px solid rgba(255, 193, 7, 0.8);
    }

    .btn-back {
      background: #6c757d;
      color: white;
    }

    .btn-back:hover {
      background: #5a6268;
      transform: translateY(-2px);
    }

    .btn-next {
      background: linear-gradient(135deg, #a67c52 0%, #856d4d 100%);
      color: white;
    }

    .btn-next:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 20px rgba(166, 124, 82, 0.4);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .score-display {
      text-align: center;
      font-size: 1.2em;
      color: #a67c52;
      margin-top: 20px;
    }

    .loading {
      text-align: center;
      padding: 60px 20px;
      font-size: 1.5em;
      color: #a67c52;
    }

    .loading::after {
      content: '...';
      animation: dots 1.5s steps(4, end) infinite;
    }

    @keyframes dots {
      0%, 20% { content: '.'; }
      40% { content: '..'; }
      60%, 100% { content: '...'; }
    }

    .bg-change-notification {
      position: fixed;
      top: 20px;
      right: 20px;
      background: linear-gradient(135deg, #a67c52 0%, #856d4d 100%);
      color: white;
      padding: 15px 25px;
      border-radius: 10px;
      font-size: 1.1em;
      font-weight: bold;
      box-shadow: 0 5px 20px rgba(76, 175, 80, 0.5);
      z-index: 1000;
      animation: slideInRight 0.5s ease, fadeOut 0.5s ease 2.5s forwards;
    }

    @keyframes slideInRight {
      from {
        transform: translateX(400px);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }

    @keyframes fadeOut {
      to {
        opacity: 0;
        transform: translateX(400px);
      }
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      body {
        padding: 15px 10px;
      }

      .container {
        padding: 20px 15px;
      }

      /* Level Selection Mobile */
      .level-selection {
        padding: 40px 15px;
      }

      .level-selection h1 {
        font-size: 2.5em;
        margin-bottom: 15px;
      }

      .subtitle {
        font-size: 1.1em;
        margin-bottom: 35px;
      }

      .level-cards {
        grid-template-columns: 1fr;
        gap: 25px;
        max-width: 400px;
      }

      .level-card {
        padding: 35px 25px;
      }

      .level-icon {
        font-size: 3em;
        margin-bottom: 15px;
      }

      .level-title {
        font-size: 2.2em;
        margin-bottom: 12px;
      }

      .level-desc {
        font-size: 1.2em;
        margin-bottom: 15px;
      }

      .level-info {
        font-size: 1em;
      }

      .level-stats {
        font-size: 0.9em;
        margin-top: 20px;
        padding-top: 15px;
      }

      /* Game Section Mobile */
      #gameSection h1 {
        font-size: 2.2em;
        margin-bottom: 25px;
      }

      .score-header {
        padding: 20px;
        margin-bottom: 25px;
        gap: 15px;
      }

      .score-item {
        padding: 12px;
      }

      .score-label {
        font-size: 0.85em;
      }

      .score-value {
        font-size: 1.8em;
      }

      .progress-bar {
        height: 12px;
        margin-bottom: 30px;
      }

      .question-card {
        padding: 25px 20px;
      }

      .question-number {
        font-size: 1.1em;
        margin-bottom: 20px;
        flex-direction: column;
        gap: 10px;
      }

      .instruction {
        font-size: 1em;
        padding: 15px 20px;
        margin-bottom: 20px;
      }

      .question-text {
        font-size: 1.4em;
        margin-bottom: 25px;
        padding: 15px;
      }

      .options {
        grid-template-columns: 1fr;
        gap: 15px;
      }

      .option {
        padding: 20px 15px;
        font-size: 1.1em;
      }

      .nav-buttons {
        margin-top: 30px;
        gap: 15px;
      }

      .btn {
        padding: 12px 25px;
        font-size: 1.1em;
      }

      .bg-change-notification {
        top: 15px;
        right: 15px;
        padding: 15px 20px;
        font-size: 1em;
      }
    }

    @media (max-width: 480px) {
      body {
        padding: 10px 5px;
      }

      .container {
        padding: 15px 10px;
      }

      /* Level Selection Small Mobile */
      .level-selection {
        padding: 30px 10px;
      }

      .level-selection h1 {
        font-size: 2em;
        margin-bottom: 12px;
      }

      .subtitle {
        font-size: 1em;
        margin-bottom: 30px;
      }

      .level-cards {
        gap: 20px;
        max-width: 100%;
      }

      .level-card {
        padding: 30px 20px;
      }

      .level-icon {
        font-size: 2.5em;
        margin-bottom: 12px;
      }

      .level-title {
        font-size: 1.8em;
        margin-bottom: 10px;
      }

      .level-desc {
        font-size: 1.1em;
        margin-bottom: 12px;
      }

      .level-info {
        font-size: 0.95em;
      }

      .level-stats {
        font-size: 0.85em;
        margin-top: 15px;
        padding-top: 12px;
      }

      /* Game Section Small Mobile */
      #gameSection h1 {
        font-size: 1.8em;
        margin-bottom: 20px;
      }

      .score-header {
        padding: 15px;
        margin-bottom: 20px;
        gap: 10px;
      }

      .score-item {
        padding: 10px;
      }

      .score-label {
        font-size: 0.8em;
      }

      .score-value {
        font-size: 1.5em;
      }

      .progress-bar {
        height: 10px;
        margin-bottom: 25px;
      }

      .question-card {
        padding: 20px 15px;
      }

      .question-number {
        font-size: 1em;
        margin-bottom: 15px;
      }

      .instruction {
        font-size: 0.95em;
        padding: 12px 15px;
        margin-bottom: 15px;
      }

      .question-text {
        font-size: 1.2em;
        margin-bottom: 20px;
        padding: 12px;
      }

      .options {
        gap: 12px;
      }

      .option {
        padding: 15px 12px;
        font-size: 1em;
      }

      .nav-buttons {
        margin-top: 25px;
        gap: 12px;
        flex-direction: column;
      }

      .btn {
        padding: 12px 20px;
        font-size: 1em;
        width: 100%;
        justify-content: center;
      }

      .bg-change-notification {
        top: 10px;
        right: 10px;
        left: 10px;
        padding: 12px 15px;
        font-size: 0.9em;
        text-align: center;
      }
    }

    @media (min-width: 769px) and (max-width: 1024px) {
      .container {
        max-width: 800px;
      }

      .level-selection h1 {
        font-size: 3em;
      }

      #gameSection h1 {
        font-size: 2.8em;
      }

      .question-text {
        font-size: 1.6em;
      }

      .level-cards {
        max-width: 1000px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- หน้าเลือก Level -->
    <div id="levelSelection" class="level-selection">
      <h1>🎌 เลือกระดับความยาก</h1>
      <p class="subtitle">เลือกระดับที่เหมาะกับความสามารถของคุณ</p>
      
      <div class="level-cards">
        <div class="level-card n5" onclick="startQuiz('N5')">
          <div class="level-icon">🌸</div>
          <div class="level-title">N5</div>
          <div class="level-desc">ระดับเริ่มต้น</div>
          <div class="level-info">คำศัพท์พื้นฐาน ไวยากรณ์เบื้องต้น<br>เหมาะสำหรับผู้เริ่มต้น</div>
          <div class="level-stats">📚 คำถาม: ง่าย | ⏱️ เวลา: ไม่จำกัด</div>
        </div>
        
        <div class="level-card n4" onclick="startQuiz('N4')">
          <div class="level-icon">🗾</div>
          <div class="level-title">N4</div>
          <div class="level-desc">ระดับกลาง</div>
          <div class="level-info">คำศัพท์ขั้นสูง ไวยากรณ์ซับซ้อน<br>เหมาะสำหรับผู้มีพื้นฐาน</div>
          <div class="level-stats">📚 คำถาม: ปานกลาง | ⏱️ เวลา: ไม่จำกัด</div>
        </div>
      </div>
    </div>

    <!-- หน้าเกม Quiz -->
    <div id="gameSection" style="display: none;">
      <h1>🎯 Japanese Quiz</h1>
      
      <div class="score-header">
        <div class="score-item">
          <div class="score-label">คะแนน</div>
          <div class="score-value" id="currentScore">0</div>
        </div>
        <div class="score-item">
          <div class="score-label">ตอบถูก</div>
          <div class="score-value" id="correctCount">0</div>
        </div>
        <div class="score-item">
          <div class="score-label">ตอบผิด</div>
          <div class="score-value" id="wrongCount">0</div>
        </div>
      </div>
      
      <div class="progress-bar">
        <div class="progress" id="progressBar"></div>
      </div>

      <div id="quizContainer">
        <div class="loading">กำลังโหลดคำถาม</div>
      </div>

      <div class="nav-buttons" id="navButtons" style="display: none;">
        <button class="btn btn-back" onclick="backToLevelSelection()">← เลือกระดับใหม่</button>
        <button class="btn btn-next" id="nextBtn" onclick="nextQuestion()" style="display: none;">ถัดไป →</button>
      </div>

      <div class="score-display" id="scoreDisplay"></div>
    </div>
  </div>

  <script>
    let quizData = [];
    let currentQuestion = 0;
    let userAnswers = [];
    let selectedLevel = '';
    let currentScore = 0;
    let correctAnswers = 0;
    let wrongAnswers = 0;
    let isAnswered = false;

    // รูปพื้นหลังตามคะแนน
    const backgrounds = [
      '/images/bg1.png',  // 0-4 คะแนน
      '/images/bg2.jpg',  // 5-9 คะแนน
      '/images/bg3.png',  // 10-14 คะแนน
      '/images/bg4.png',  // 15-19 คะแนน
      '/images/bg5.png',  // 20-24 คะแนน
      '/images/bg6.png',  // 25-29 คะแนน
      '/images/bg7.png',  // 30-34 คะแนน
      '/images/bg8.png',  // 35-39 คะแนน
      '/images/bg9.png',  // 40-44 คะแนน
      '/images/bg10.png'  // 45+ คะแนน
    ];

    // เริ่มเกมตาม Level ที่เลือก
    async function startQuiz(level) {
      selectedLevel = level;
      document.getElementById('levelSelection').style.display = 'none';
      document.getElementById('gameSection').style.display = 'block';
      
      await loadQuestions();
    }

    // กลับไปหน้าเลือก Level
    function backToLevelSelection() {
      // รีเซ็ตค่าทั้งหมด
      quizData = [];
      currentQuestion = 0;
      userAnswers = [];
      currentScore = 0;
      correctAnswers = 0;
      wrongAnswers = 0;
      isAnswered = false;
      
      // แสดงหน้าเลือก Level
      document.getElementById('gameSection').style.display = 'none';
      document.getElementById('levelSelection').style.display = 'block';
      
      // รีเซ็ตพื้นหลัง
      document.body.style.backgroundImage = '';
      document.body.classList.remove('has-background');
    }

    // โหลดข้อมูลจาก questions.json
    async function loadQuestions() {
      try {
        const response = await fetch('/questions.json');
        const allQuestions = await response.json();
        const normalizedQuestions = allQuestions
          .map(normalizeQuestion)
          .filter(q => q.question && q.options.length > 0);
        
        // กรองคำถามตาม level
        if (selectedLevel === 'ALL') {
          quizData = shuffleArray(normalizedQuestions);
        } else {
          const filtered = normalizedQuestions.filter(q => q.level === selectedLevel);
          quizData = shuffleArray(filtered);
        }
        
        // จำกัดจำนวนคำถาม (สูงสุด 20 ข้อ)
        quizData = quizData.slice(0, Math.min(20, quizData.length));
        
        if (quizData.length === 0) {
          document.getElementById('quizContainer').innerHTML =
            '<div class="loading" style="color: #ff6b6b;">ไม่พบคำถามสำหรับระดับนี้ กรุณาลองเลือกระดับอื่น</div>';
          document.getElementById('navButtons').style.display = 'none';
          return;
        }
        
        userAnswers = new Array(quizData.length).fill(null);
        
        // แสดงปุ่มนำทาง
        document.getElementById('navButtons').style.display = 'flex';
        
        // ตั้งค่าพื้นหลังเริ่มต้น
        updateBackground();
        
        renderQuiz();
      } catch (error) {
        console.error('Error loading questions:', error);
        document.getElementById('quizContainer').innerHTML = 
          '<div class="loading" style="color: red;">ไม่สามารถโหลดคำถามได้ กรุณาลองใหม่อีกครั้ง</div>';
      }
    }

    function normalizeLevel(level) {
      return String(level || '').toUpperCase().replace(/\s+/g, '');
    }

    function normalizeQuestion(raw) {
      const options = Array.isArray(raw.options)
        ? raw.options
        : [raw.option1, raw.option2, raw.option3, raw.option4];

      const cleanOptions = options
        .map(opt => String(opt || '').trim())
        .filter(Boolean);

      const answerNumber = Number(raw.answer);

      return {
        ...raw,
        level: normalizeLevel(raw.level),
        options: cleanOptions,
        answer: Number.isFinite(answerNumber) ? answerNumber : 1
      };
    }

    // ฟังก์ชันสุ่มข้อมูล
    function shuffleArray(array) {
      const newArray = [...array];
      for (let i = newArray.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
      }
      return newArray;
    }

    function renderQuiz() {
      if (quizData.length === 0) {
        document.getElementById('quizContainer').innerHTML =
          '<div class="loading" style="color: #ff6b6b;">ยังไม่มีคำถามให้แสดง</div>';
        return;
      }
      
      const container = document.getElementById('quizContainer');
      container.innerHTML = '';

      const q = quizData[currentQuestion];
      const card = document.createElement('div');
      card.className = 'question-card active';
      
      const levelBadge = `<span style="background: ${q.level === 'N5' ? '#a67c52' : '#856d4d'}; color: white; padding: 4px 12px; border-radius: 12px; font-size: 0.9em; margin-left: 10px;">${q.level}</span>`;
      
      card.innerHTML = `
        <div class="question-number">คำถามที่ ${currentQuestion + 1} จาก ${quizData.length} ${levelBadge}</div>
        <div class="instruction">${q.instruction}</div>
        <div class="question-text">${q.question}</div>
        <div class="options">
          ${q.options.map((opt, i) => `
            <div class="option" onclick="selectAnswer(${i})" data-option="${i}">
              ${String.fromCharCode(65 + i)}. ${opt}
            </div>
          `).join('')}
        </div>
      `;
      
      container.appendChild(card);
      updateProgress();
      updateButtons();
    }

    function selectAnswer(optionIndex) {
      if (isAnswered) return; // ป้องกันคลิกซ้ำ
      
      isAnswered = true;
      userAnswers[currentQuestion] = optionIndex;
      
      const currentQ = quizData[currentQuestion];
      const isCorrect = optionIndex === (currentQ.answer - 1); // แปลงจาก 1-based เป็น 0-based
      
      // อัพเดทคะแนน
      if (isCorrect) {
        currentScore++;
        correctAnswers++;
        updateScoreDisplay();
        updateBackground();
      } else {
        wrongAnswers++;
        updateScoreDisplay();
      }
      
      showFeedback(optionIndex, isCorrect);
      
      // รอ 2 วินาที แล้วไปข้อถัดไปหรือส่งคำตอบ
      setTimeout(() => {
        isAnswered = false;
        if (currentQuestion < quizData.length - 1) {
          currentQuestion++;
          renderQuiz();
        } else {
          // ข้อสุดท้าย ส่งคำตอบทันที
          submitQuiz();
        }
      }, 2000);
    }

    function showFeedback(selectedOption, isCorrect) {
      const options = document.querySelectorAll('.option');
      const correctOption = quizData[currentQuestion].answer - 1; // แปลงจาก 1-based เป็น 0-based
      
      options[selectedOption].classList.add(isCorrect ? 'correct' : 'wrong');
      
      if (!isCorrect) {
        options[correctOption].classList.add('correct');
      }
      
      // ปิดการคลิกทุกตัวเลือก
      options.forEach(option => {
        option.style.pointerEvents = 'none';
      });
    }

    function updateScoreDisplay() {
      document.getElementById('currentScore').textContent = currentScore;
      document.getElementById('correctCount').textContent = correctAnswers;
      document.getElementById('wrongCount').textContent = wrongAnswers;
      
      // Animation
      document.getElementById('currentScore').classList.add('correct-animation');
      setTimeout(() => {
        document.getElementById('currentScore').classList.remove('correct-animation');
      }, 500);
    }

    function updateBackground() {
      // เปลี่ยนพื้นหลังทุก 5 คะแนน
      const bgIndex = Math.min(Math.floor(currentScore / 5), backgrounds.length - 1);
      const bgUrl = backgrounds[bgIndex];
      
      // ตรวจสอบว่าพื้นหลังเปลี่ยนหรือไม่
      const currentBg = document.body.style.backgroundImage;
      const newBg = `url("${bgUrl}")`;
      
      if (currentBg !== newBg) {
        document.body.style.backgroundImage = newBg;
        document.body.style.backgroundSize = 'cover';
        document.body.style.backgroundPosition = 'center';
        document.body.style.backgroundAttachment = 'fixed';
        document.body.classList.add('has-background');
        
        // แสดงการแจ้งเตือนเมื่อพื้นหลังเปลี่ยน (ยกเว้นครั้งแรก)
        if (currentScore >= 5) {
          showBackgroundChangeNotification();
        }
      }
    }

    function showBackgroundChangeNotification() {
      const notification = document.createElement('div');
      notification.className = 'bg-change-notification';
      notification.textContent = '🎉 ระดับใหม่! พื้นหลังเปลี่ยนแล้ว!';
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.remove();
      }, 3000);
    }

    function updateProgress() {
      const progress = ((currentQuestion + 1) / quizData.length) * 100;
      document.getElementById('progressBar').style.width = progress + '%';
    }

    function updateButtons() {
      const nextBtn = document.getElementById('nextBtn');
      nextBtn.style.display = 'none'; // ซ่อนปุ่มถัดไป (ระบบจะเปลี่ยนข้ออัตโนมัติ)
    }

    function nextQuestion() {
      if (currentQuestion < quizData.length - 1 && !isAnswered) {
        currentQuestion++;
        renderQuiz();
      }
    }

    function submitQuiz() {
      // Redirect ไปหน้า result พร้อมคะแนน
      window.location.href = `/result?score=${currentScore}&total=${quizData.length}&level=${selectedLevel}`;
    }

    // ตรวจสอบว่ามี level จาก URL หรือไม่ (สำหรับ direct link)
    const urlParams = new URLSearchParams(window.location.search);
    const levelFromUrl = urlParams.get('level');
    
    if (levelFromUrl && ['N4', 'N5', 'ALL'].includes(levelFromUrl)) {
      startQuiz(levelFromUrl);
    }
  </script>
</body>
</html>
