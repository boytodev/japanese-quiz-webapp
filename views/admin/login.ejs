<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เข้าสู่ระบบผู้ดูแล - เกมควิซภาษาญี่ปุ่น</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-image: url('/images/bg2.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .login-container {
      background: rgba(255, 255, 255, 0.95);
      padding: 50px 60px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 400px;
      width: 100%;
    }

    .overlay {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.18);
    }

    h1 {
      color: #a67c52;
      text-align: center;
      margin-bottom: 10px;
      font-size: 2em;
    }

    .subtitle {
      text-align: center;
      color: #666;
      margin-bottom: 30px;
      font-size: 0.9em;
    }

    .form-group {
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      color: #333;
      font-weight: 600;
    }

    input[type="password"] {
      width: 100%;
      padding: 12px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 1em;
      transition: border-color 0.3s;
    }

    input[type="password"]:focus {
      outline: none;
      border-color: #856d4d;
    }

    .login-btn {
      width: 100%;
      background: linear-gradient(135deg, #a67c52 0%, #856d4d 100%);
      color: white;
      border: none;
      padding: 15px;
      font-size: 1.1em;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.3s;
      font-weight: 600;
    }

    .login-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(166, 124, 82, 0.4);
    }

    .error {
      background: #ffebee;
      color: #c62828;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      text-align: center;
      border: 1px solid #ef5350;
    }

    .back-link {
      text-align: center;
      margin-top: 20px;
    }

    .back-link a {
      color: #a67c52;
      text-decoration: none;
      font-weight: 500;
    }

    .back-link a:hover {
      text-decoration: underline;
    }

    @media (max-width: 480px) {
      .login-container {
        padding: 40px 30px;
      }

      h1 {
        font-size: 1.6em;
      }
    }
  </style>
</head>
<body>
  <div class="login-container overlay">
    <h1>🔐 เข้าสู่ระบบผู้ดูแล</h1>
    <p class="subtitle">แดชบอร์ดเกมควิซภาษาญี่ปุ่น</p>
    
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label>รหัสผ่าน Admin</label>
        <input type="password" name="password" required autofocus placeholder="กรุณากรอกรหัสผ่าน">
      </div>
      
      <button type="submit" class="login-btn">เข้าสู่ระบบ</button>
    </form>

    <div class="back-link">
      <a href="/">← กลับหน้าแรก</a>
    </div>
  </div>
</body>
</html>
